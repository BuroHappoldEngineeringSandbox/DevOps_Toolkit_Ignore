<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Compliance.Shared\Compliance.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BHoM and BHoM_Engine are referenced transitively via Compliance.Shared. -->
    <!-- CodeComplianceTest_Engine, CodeComplianceTest_oM, Test_Engine, Test_oM are -->
    <!-- referenced directly here because ComplianceRunner.cs calls RunChecks,      -->
    <!-- CheckProjectFile, CheckAssemblyInfo, Merge, and the Error/Location types.  -->
    <Reference Include="BHoM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM.dll</HintPath>
    </Reference>
    <Reference Include="CodeComplianceTest_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\CodeComplianceTest_Engine.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="CodeComplianceTest_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\CodeComplianceTest_oM.dll</HintPath>
    </Reference>
    <Reference Include="Test_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Test_Engine.dll</HintPath>
    </Reference>
    <Reference Include="Test_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Test_oM.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
